# ChainGuard configuration
# Copy this file to `.env` and adjust as needed.
# The app works fully offline out of the box with USE_DEMO_MODE=true —
# no keys are required for the demo.

# --- Application ---
APP_NAME=ChainGuard
APP_VERSION=1.0.0
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=5000

# --- Mode selection ---
# USE_DEMO_MODE is the single source of truth for demo vs. live data.
# When true, all analysis uses the deterministic offline demo scenarios
# in blockchain/demo_provider.py — no API keys needed.
# When false, live Ethereum data is fetched via the Etherscan API V2 and the
# corresponding *_ETHERSCAN key below is required for the requested chain.
# ChainGuard never silently falls back to demo data in live mode.
USE_DEMO_MODE=true

# One Etherscan API V2 key works for every chain; put the same key in both
# variables if you want to analyze both networks. (*_RPC are reserved/unused.)

# --- Blockchain: Ethereum Mainnet (only needed if USE_DEMO_MODE=false) ---
ETH_MAINNET_RPC=
ETH_MAINNET_ETHERSCAN=

# --- Blockchain: Sepolia Testnet (only needed if USE_DEMO_MODE=false) ---
ETH_SEPOLIA_RPC=
ETH_SEPOLIA_ETHERSCAN=

# --- HTTP client (live mode) ---
PROVIDER_TIMEOUT_SECONDS=15
MAX_COUNTERPARTY_CLASSIFICATION_CALLS=12

# --- Risk Engine (informational; the scorer uses its own constants) ---
RISK_ENGINE_VERSION=1.0
REPUTATION_SCORE_MIN=0
REPUTATION_SCORE_MAX=100

# --- RESERVED: not implemented ---
# There is no LLM/AI explainer in this build; nothing reads these two values.
# The reputation score is always computed by deterministic rules.
GROQ_API_KEY=
ENABLE_AI_EXPLAINER=false

# --- Storage (cached analyses + search history; relative to project root) ---
DB_PATH=data
